{
  "version": 1,
  "site": {
    "timezone": "Asia/Kolkata",
    "cameras": {}
  },
  "authorized_plates_csv": "configs/authorized_plates_demo.csv",
  "rules": [
    {
      "rule_id": "R001",
      "name": "Restricted Zone Entry",
      "description": "A person or vehicle is inside a restricted zone",
      "event_type": "ZONE_VIOLATION",
      "conditions": [
        {
          "type": "object",
          "value": [
            "person",
            "car",
            "truck",
            "bus",
            "motorcycle",
            "bicycle"
          ]
        },
        {
          "type": "zone",
          "zone_type": "restricted"
        }
      ],
      "action": {
        "severity": "HIGH",
        "score": 30
      },
      "cooldown_s": 0,
      "rearm_s": 30
    },
    {
      "rule_id": "R002",
      "name": "Wrong Direction",
      "description": "A line is crossed in a direction other than the expected one",
      "event_type": "DIRECTION_VIOLATION",
      "conditions": [
        {
          "type": "object",
          "value": [
            "person",
            "car",
            "truck",
            "bus",
            "motorcycle",
            "bicycle"
          ]
        },
        {
          "type": "line_crossing",
          "line": "L1",
          "expected_direction": "IN",
          "within_s": 5
        }
      ],
      "action": {
        "severity": "MEDIUM",
        "score": 20
      }
    },
    {
      "rule_id": "R003",
      "name": "Loitering",
      "description": "A person stays inside a zone for more than 60 seconds",
      "event_type": "LOITERING_VIOLATION",
      "conditions": [
        {
          "type": "object",
          "value": [
            "person"
          ]
        },
        {
          "type": "zone",
          "zone_type": "any",
          "min_dwell_s": 60
        }
      ],
      "action": {
        "severity": "MEDIUM",
        "score": 15
      }
    },
    {
      "rule_id": "R004",
      "name": "After-Hours Activity",
      "description": "Movement of a tracked object between 22:00 and 05:00 local time",
      "event_type": "AFTER_HOURS_ACTIVITY",
      "conditions": [
        {
          "type": "object",
          "value": [
            "person",
            "car",
            "truck",
            "bus",
            "motorcycle",
            "bicycle"
          ]
        },
        {
          "type": "time",
          "between": [
            "22:00",
            "05:00"
          ]
        },
        {
          "type": "track_age",
          "min_s": 2
        }
      ],
      "action": {
        "severity": "LOW",
        "score": 10
      },
      "rearm_s": 3600
    },
    {
      "rule_id": "R005",
      "name": "Unauthorized Vehicle in Restricted Zone After Hours",
      "description": "Section 38 example: a vehicle in a restricted zone at night whose plate is not in the authorized list",
      "event_type": "UNAUTHORIZED_VEHICLE_AFTER_HOURS",
      "conditions": [
        {
          "type": "object",
          "value": [
            "car",
            "truck",
            "bus",
            "motorcycle"
          ]
        },
        {
          "type": "zone",
          "zone_type": "restricted"
        },
        {
          "type": "time",
          "between": [
            "22:00",
            "05:00"
          ]
        },
        {
          "type": "plate",
          "authorized": false
        }
      ],
      "action": {
        "severity": "CRITICAL",
        "score": 40
      }
    }
  ],
  "scoring": {
    "max_score": 100,
    "window_s": 600,
    "alert_min_score": 10,
    "cooldown_s": 60,
    "rearm_s": 300,
    "merge_by_plate": true,
    "merge_scope": "camera",
    "levels": [
      {
        "name": "LOW",
        "min": 0
      },
      {
        "name": "MEDIUM",
        "min": 30
      },
      {
        "name": "HIGH",
        "min": 60
      },
      {
        "name": "CRITICAL",
        "min": 80
      }
    ],
    "bonus": {
      "multiple_suspicious": {
        "points": 10,
        "min_distinct_kinds": 4
      }
    },
    "sources": [
      {
        "id": "zone_violation",
        "label": "Restricted zone entry",
        "match": {
          "event_type": "ZONE_VIOLATION"
        },
        "points": "from_event"
      },
      {
        "id": "direction_violation",
        "label": "Unauthorized direction",
        "match": {
          "event_type": "DIRECTION_VIOLATION"
        },
        "points": "from_event"
      },
      {
        "id": "loitering",
        "label": "Loitering over 60 seconds",
        "match": {
          "event_type": "LOITERING_VIOLATION"
        },
        "points": "from_event"
      },
      {
        "id": "after_hours",
        "label": "After-hours movement",
        "match": {
          "event_type": "AFTER_HOURS_ACTIVITY"
        },
        "points": "from_event"
      },
      {
        "id": "unauthorized_vehicle_night",
        "label": "Unauthorized vehicle at night in a restricted zone",
        "match": {
          "event_type": "UNAUTHORIZED_VEHICLE_AFTER_HOURS"
        },
        "points": "from_event"
      },
      {
        "id": "line_crossing",
        "label": "Virtual line crossing",
        "match": {
          "event_type": "LINE_CROSSING",
          "where": {
            "rule_type": "tripwire"
          }
        },
        "points": 20,
        "excluded_by": [
          "direction_violation"
        ]
      },
      {
        "id": "watchlist_vehicle",
        "label": "Watchlisted vehicle",
        "match": {
          "event_type": "WATCHLIST_MATCH",
          "where": {
            "details.entity_type": [
              "VEHICLE",
              "PLATE"
            ]
          }
        },
        "points": 40,
        "status_multiplier": {
          "alert": 1.0,
          "review": 0.5
        }
      },
      {
        "id": "watchlist_person",
        "label": "Watchlisted person",
        "match": {
          "event_type": "WATCHLIST_MATCH",
          "where": {
            "details.entity_type": [
              "PERSON",
              "FACE"
            ]
          }
        },
        "points": 50,
        "status_multiplier": {
          "alert": 1.0,
          "review": 0.5
        }
      }
    ]
  }
}