flowchart TB
  subgraph HOST["Host Operating System Interface (Linux / macOS / WSL2)"]
    PORT80["Published Port 80 (HTTP Redirect)"]
    PORT443["Published Port 443 (HTTPS / WSS / MJPEG)"]
  end

  subgraph EDGE["Docker Network: border-frontend-net"]
    NGX["Nginx Edge Proxy<br/>(TLS 1.3, Rate Limits, CSP)"]
    FE["Frontend SPA Server<br/>(Unprivileged Nginx :8080)"]
    BE["Backend API / WS<br/>(Node.js 22 :4000)"]
  end

  subgraph DATA["Docker Network: border-data-net (Internal Only)"]
    PG[("PostgreSQL 16 (:5432)<br/>Volume: postgres_data")]
    RD[("Redis 7 (:6379)<br/>Volume: redis_data")]
    SINK["Asynchronous DB Sink Worker"]
    RET["Data Retention Worker Daemon"]
    INIT["One-Shot Bootstrap Jobs<br/>(db-init, migrate, model-init)"]
  end

  subgraph MEDIA["Docker Network: border-media-net (Internal Only)"]
    ENG["AI Video Intelligence Engine<br/>(:8001 Metrics)"]
    MMTX["MediaMTX RTSP Server<br/>(:8554 RTSP)"]
    SIM["CCTV Multi-Camera Simulator<br/>(4 Synthetic Feeds)"]
  end

  PORT80 --> NGX
  PORT443 --> NGX

  NGX --> FE
  NGX --> BE
  NGX --> ENG

  BE --> PG
  BE --> RD
  SINK --> PG
  SINK --> RD
  RET --> PG
  INIT --> PG
  INIT --> RD

  ENG --> RD
  ENG --> PG
  ENG --> MMTX
  SIM --> MMTX

  subgraph SECRETS["Docker Compose Secrets (/run/secrets/*)"]
    S1["postgres_admin_password"]
    S2["backend_db_password"]
