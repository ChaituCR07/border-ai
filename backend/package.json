{
  "name": "backend",
  "version": "1.0.0",
  "description": "Border-AI Video Intelligence Platform Backend REST API",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p .",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx --env-file=.env scripts/migrate.ts",
    "test": "vitest run",
    "test:db": "REQUIRE_DB=1 vitest run",
    "seed": "tsx --env-file=.env scripts/seed-synthetic.ts",
    "smoke": "bash scripts/smoke.sh"
  },
  "keywords": [
    "border-ai",
    "fastify",
    "rest-api",
    "typescript",
    "surveillance"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^10.1.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.1.1",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "dotenv": "^18.0.5",
    "fastify": "^5.2.1",
    "fastify-type-provider-zod": "^4.0.2",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
