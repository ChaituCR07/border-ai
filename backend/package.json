{
  "name": "backend",
  "version": "1.0.0",
  "description": "Border-AI Video Intelligence Platform Backend REST API",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p .",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx --env-file=.env scripts/migrate.ts",
    "test": "vitest run",
    "test:db": "REQUIRE_DB=1 vitest run",
    "seed": "tsx --env-file=.env scripts/seed-synthetic.ts",
    "topology:check": "tsx scripts/topology-check.ts",
    "topology:seed": "tsx --env-file=.env scripts/topology-seed.ts",
    "notifications:check": "tsx scripts/notifications-check.ts",
    "fixtures:seed": "tsx scripts/seed-correlation-fixtures.ts",
    "export:openapi": "tsx scripts/export-openapi.ts",
    "smoke": "bash scripts/smoke.sh",
    "smoke:correlation": "tsx scripts/smoke-correlation.ts",
    "smoke:notifications": "tsx scripts/smoke-notifications.ts",
    "bench:argon2": "tsx scripts/bench-argon2.ts",
    "keys:generate": "tsx scripts/generate-keys.ts",
    "demo:alert": "python3 ../scripts/emit_demo_alert.py"
  },
  "keywords": [
    "border-ai",
    "fastify",
    "rest-api",
    "typescript",
    "surveillance"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@border-ai/protocol": "file:../shared/protocol",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.1.1",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "@fastify/websocket": "^11.3.4",
    "dotenv": "^18.0.5",
    "fastify": "^5.2.1",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.13.3",
    "sharp": "^0.35.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/ioredis": "^4.28.10",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.11",
    "@types/sharp": "^0.31.1",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "vite": "^8.3.5",
    "vitest": "^3.0.7"
  }
}
