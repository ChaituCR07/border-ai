# Border-AI Production Deployment Configuration
# NOTE: Secrets (passwords, private keys, peppers) must NEVER be placed in this file.
# Run `./scripts/gen_secrets.sh` to provision secure file-based secrets under ./secrets/

COMPOSE_PROJECT_NAME=border-ai
IMAGE_TAG=dev
TORCH_VARIANT=cpu                # cpu | cu121
PUBLIC_HOST=localhost
HTTPS_PORT=443
HTTP_PORT=80
TZ=UTC

# Data Retention Policies (Days)
RETENTION_EVENTS_DAYS=30
RETENTION_SNAPSHOTS_DAYS=14
RETENTION_AUDIT_DAYS=365

# Surveillance & Analytics Pacing
ANALYTICS_FPS=10
OFFLINE=0                        # Set to 1 to forbid external model weight downloads

# Notification Delivery
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_DRY_RUN=true       # Safe default; set false deliberately with real SMTP
NOTIFY_ALLOWED_DOMAINS=example.org,border-ai.local
